<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('site_title_about') %></title>
  <meta name="description" content="<%= t('about_subtitle') %>">
  <meta property="og:title" content="<%= t('site_title_about') %>">
  <meta property="og:description" content="<%= t('about_subtitle') %>">
  <meta property="og:url" content="<%= baseUrl %>/about">
  <link rel="canonical" href="<%= baseUrl %>/about">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f2f0e9; --bg-card: rgba(255,255,255,0.8); --text: #1a1a1a; --text-secondary: #555;
      --border: rgba(0,0,0,0.1); --accent: #000; --shadow: rgba(0,0,0,0.08);
      --hover-bg: rgba(0,0,0,0.05); --tag-bg: #e8e6df;
    }
    [data-theme="dark"] {
      --bg: #1a1a1a; --bg-card: rgba(30,30,30,0.9); --text: #e0e0e0; --text-secondary: #999;
      --border: rgba(255,255,255,0.1); --accent: #fff; --shadow: rgba(0,0,0,0.3);
      --hover-bg: rgba(255,255,255,0.08); --tag-bg: #2a2a2a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0; font-family: 'Noto Serif TC', serif;
      background: var(--bg); color: var(--text);
      transition: background 0.3s, color 0.3s;
      display: flex; flex-direction: column; align-items: center; min-height: 100vh;
    }
    .container { width: 90%; max-width: 720px; padding: 40px 0; flex: 1; }

    /* Nav styles */
    .site-nav { background-color: #000; margin-bottom: 40px; }
    .site-nav ul { list-style: none; margin: 0; padding: 0 10px; display: flex; flex-wrap: wrap; }
    .site-nav li a { color: #fff; text-decoration: none; display: block; padding: 8px 14px; font-size: 14px; }
    .site-nav li a:hover { text-decoration: underline; }
    .dropdown { position: relative; }
    .dropdown-menu {
      position: absolute; top: 100%; left: 0; background: #000;
      flex-direction: column; min-width: 140px; z-index: 9999;
      padding: 4px 0; margin: 0; list-style: none;
      opacity: 0; visibility: hidden; pointer-events: none;
      transform: translateY(-4px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }
    .dropdown:hover .dropdown-menu,
    .dropdown.active .dropdown-menu {
      opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0);
    }
    .dropdown-menu li a { white-space: nowrap; padding: 8px 14px; display: block; }
    .dropdown-menu li a:hover { background: rgba(255,255,255,0.1); }
    .dropdown > a .arrow { display: inline-block; transition: transform 0.25s ease; font-size: 0.7rem; margin-left: 4px; }
    .dropdown:hover > a .arrow,
    .dropdown.active > a .arrow { transform: rotate(180deg); }

    h1 { font-size: 2rem; margin: 0 0 8px; }
    .subtitle { color: var(--text-secondary); margin-bottom: 32px; }
    section { margin-bottom: 32px; }
    section h2 { font-size: 1.3rem; margin: 0 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
    section p { line-height: 1.8; color: var(--text-secondary); margin: 0 0 12px; }
    .values { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
    .value-card {
      padding: 20px; background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 8px; transition: 0.2s;
    }
    .value-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px var(--shadow); }
    .value-card h3 { margin: 0 0 6px; font-size: 1rem; }
    .value-card p { margin: 0; font-size: 0.9rem; }
    .skills { display: flex; flex-wrap: wrap; gap: 8px; }
    .skill-tag { padding: 4px 14px; background: var(--tag-bg); border-radius: 20px; font-size: 0.85rem; color: var(--text-secondary); }

    /* Footer styles */
    .site-footer { border-top: 4px solid #000; padding: 20px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #666; margin-top: 40px; }
    .site-footer strong { font-size: 16px; color: #000; }
    .footer-desc { font-size: 12px; color: #888; margin-left: 8px; }
    .footer-right { text-align: right; }
    .footer-links { margin-left: 12px; }
    .footer-links a { color: #888; text-decoration: none; margin-left: 8px; }
    .footer-links a:hover { color: #0066cc; text-decoration: underline; }
    .site-footer a { color: #888; text-decoration: none; }
    .site-footer a:hover { color: #0066cc; text-decoration: underline; }

    @media (max-width: 600px) {
      .container { width: 95%; padding: 20px 0; }
      .values { grid-template-columns: 1fr; }
      .site-footer { flex-direction: column; gap: 8px; text-align: center; }
      .footer-right { text-align: center; }
      .footer-desc { display: none; }
    }
  </style>
</head>
<body>
  <div class="container">
    <%- include('partials/navbar') %>
    <h1>ℹ️ <%= t('about_title') %></h1>
    <p class="subtitle"><%= t('about_subtitle') %></p>

    <section>
      <h2>📖 <%= t('about_origin_title') %></h2>
      <p><%= t('about_origin_p1') %></p>
      <p><%= t('about_origin_p2') %></p>
    </section>

    <section>
      <h2>🎯 <%= t('about_audience_title') %></h2>
      <div class="values">
        <div class="value-card">
          <h3><%= t('about_card1_title') %></h3>
          <p><%= t('about_card1_desc') %></p>
        </div>
        <div class="value-card">
          <h3><%= t('about_card2_title') %></h3>
          <p><%= t('about_card2_desc') %></p>
        </div>
        <div class="value-card">
          <h3><%= t('about_card3_title') %></h3>
          <p><%= t('about_card3_desc') %></p>
        </div>
        <div class="value-card">
          <h3><%= t('about_card4_title') %></h3>
          <p><%= t('about_card4_desc') %></p>
        </div>
      </div>
    </section>

    <section>
      <h2>🛠️ <%= t('about_tech_title') %></h2>
      <div class="skills">
        <span class="skill-tag">Node.js</span>
        <span class="skill-tag">Express</span>
        <span class="skill-tag">SQLite</span>
        <span class="skill-tag">EJS</span>
        <span class="skill-tag">JavaScript</span>
        <span class="skill-tag">CSS</span>
        <span class="skill-tag">HTML</span>
        <span class="skill-tag">RSS</span>
      </div>
    </section>

    <section>
      <h2>📬 <%= t('about_contact_title') %></h2>
      <p><%= t('about_contact_desc') %> <a href="<%= baseUrl %>/contact" style="color:var(--accent);"><%= t('about_contact_link') %></a><%= t('about_contact_suffix') %></p>
    </section>
  </div>

  <%- include('partials/footer') %>

  <script>
    (function() {
      const t = localStorage.getItem('theme');
      const sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t || sys);
    })();
  </script>
</body>
</html>