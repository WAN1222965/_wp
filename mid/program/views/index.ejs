<!DOCTYPE html>
<html lang="zh-TW" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>墨 - 網誌</title>
  <meta name="description" content="墨 - 紀錄瞬間的思緒。一個簡潔優雅的技術筆記與文章平台。">
  <meta name="keywords" content="部落格,技術部落格,程式設計,網頁開發,JavaScript">
  <meta property="og:title" content="墨 - 網誌">
  <meta property="og:description" content="墨 - 紀錄瞬間的思緒。一個簡潔優雅的技術筆記與文章平台。">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= baseUrl %>/">
  <link rel="canonical" href="<%= baseUrl %>/">
  <link rel="alternate" type="application/rss+xml" title="墨 - 網誌 RSS" href="<%= baseUrl %>/rss.xml">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="<%= baseUrl %>/sitemap.xml">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f2f0e9; --bg-card: rgba(255,255,255,0.8); --text: #1a1a1a; --text-secondary: #555;
      --border: rgba(0,0,0,0.1); --accent: #000; --shadow: rgba(0,0,0,0.08);
      --hover-bg: rgba(0,0,0,0.05); --tag-bg: #e8e6df;
    }
    [data-theme="dark"] {
      --bg: #1a1a1a; --bg-card: rgba(30,30,30,0.9); --text: #e0e0e0; --text-secondary: #999;
      --border: rgba(255,255,255,0.1); --accent: #fff; --shadow: rgba(0,0,0,0.3);
      --hover-bg: rgba(255,255,255,0.08); --tag-bg: #2a2a2a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0; font-family: 'Noto Serif TC', serif;
      background: var(--bg); color: var(--text); transition: background 0.3s, color 0.3s;
      display: flex; justify-content: center;
    }
    .container { width: 90%; max-width: 720px; padding: 40px 0; }
    header { text-align: center; margin-bottom: 40px; position: relative; }
    header h1 { font-size: 3rem; letter-spacing: 10px; margin: 0; }
    header h1 a { text-decoration: none; color: var(--text); }
    .subtitle { color: var(--text-secondary); font-style: italic; margin: 8px 0 0; }
    .top-actions, .site-nav {
      display: flex; justify-content: center; gap: 8px; margin-top: 16px; flex-wrap: wrap;
    }
    .top-actions a, .top-actions button, .site-nav a {
      padding: 4px 14px; border: 1px solid var(--border); border-radius: 20px;
      text-decoration: none; color: var(--text-secondary); font-size: 0.82rem;
      background: var(--bg-card); cursor: pointer; transition: 0.2s;
      font-family: 'Noto Serif TC', serif;
    }
    .top-actions a:hover, .top-actions button:hover, .site-nav a:hover { background: var(--hover-bg); color: var(--text); }
    .site-nav a.nav-brand { font-weight: 700; letter-spacing: 2px; color: var(--text); border-color: var(--accent); }
    .search-box { margin: 20px 0; }
    .search-box input {
      width: 100%; padding: 12px 16px; border: 1px solid var(--border); border-radius: 8px;
      font-size: 1rem; background: var(--bg-card); color: var(--text);
      font-family: 'Noto Serif TC', serif; outline: none; transition: 0.2s;
    }
    .search-box input:focus { border-color: var(--accent); }
    .search-results { margin-top: 8px; }
    .search-result-item {
      padding: 12px 16px; border-bottom: 1px solid var(--border);
      cursor: pointer; transition: 0.2s; text-decoration: none; display: block; color: var(--text);
    }
    .search-result-item:hover { background: var(--hover-bg); }
    .search-result-item h4 { margin: 0 0 4px; font-size: 1rem; }
    .search-result-item p { margin: 0; font-size: 0.85rem; color: var(--text-secondary); }
    .post-card {
      background: var(--bg-card); padding: 24px; margin-bottom: 20px;
      border-left: 4px solid var(--accent); border-radius: 0 8px 8px 0;
      box-shadow: 0 2px 8px var(--shadow); transition: 0.2s;
    }
    .post-card:hover { transform: translateX(4px); }
    .post-card h2 { margin: 0 0 8px; font-size: 1.2rem; }
    .post-card h2 a { text-decoration: none; color: var(--text); }
    .post-card h2 a:hover { text-decoration: underline; }
    .post-meta { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 8px; }
    .post-excerpt { font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 12px; }
    .post-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .post-tag { padding: 2px 10px; background: var(--tag-bg); border-radius: 12px; font-size: 0.75rem; color: var(--text-secondary); text-decoration: none; }
    .read-more { color: var(--accent); text-decoration: none; font-size: 0.9rem; }
    .read-more:hover { text-decoration: underline; }
    .tag-cloud { margin: 30px 0; padding: 20px; background: var(--bg-card); border-radius: 8px; border: 1px solid var(--border); }
    .tag-cloud h3 { margin: 0 0 12px; font-size: 1rem; }
    .tag-cloud-items { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag-cloud-item { padding: 4px 14px; background: var(--tag-bg); border-radius: 20px; text-decoration: none; color: var(--text-secondary); font-size: 0.85rem; transition: 0.2s; }
    .tag-cloud-item:hover { background: var(--accent); color: var(--bg); }
    .pagination { display: flex; justify-content: center; gap: 8px; margin-top: 30px; }
    .pagination a, .pagination span {
      padding: 6px 14px; border: 1px solid var(--border); border-radius: 6px;
      text-decoration: none; color: var(--text-secondary); font-size: 0.9rem;
    }
    .pagination a:hover { background: var(--hover-bg); }
    .pagination .current { background: var(--accent); color: var(--bg); border-color: var(--accent); }
    @media (max-width: 600px) {
      .container { width: 95%; padding: 20px 0; }
      header h1 { font-size: 2rem; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1><a href="<%= baseUrl %>/">墨</a></h1>
      <p class="subtitle">紀錄瞬間的思緒</p>
      <div class="top-actions">
        <a href="<%= baseUrl %>/post/new">✏️ 新文章</a>
        <a href="<%= baseUrl %>/rss.xml" target="_blank">📡 RSS</a>
        <button onclick="toggleTheme()" id="themeBtn">🌙 深色</button>
      </div>
    </header>

    <nav class="site-nav">
      <a href="<%= baseUrl %>/" class="nav-brand">墨</a>
      <a href="<%= baseUrl %>/">📝 網誌</a>
      <a href="<%= baseUrl %>/notes">✏️ 隨筆</a>
      <a href="<%= baseUrl %>/snake.html">🐍 貪吃蛇</a>
      <a href="<%= baseUrl %>/whack.html">🎯 捕墨</a>
      <a href="<%= baseUrl %>/maze.html">🏃 墨陣</a>
      <a href="<%= baseUrl %>/leaderboard.html">🏆 排行</a>
      <a href="<%= baseUrl %>/news.html">📰 新聞</a>
    </nav>

    <div class="search-box">
      <input type="text" id="searchInput" placeholder="搜尋文章..." oninput="doSearch(this.value)">
      <div class="search-results" id="searchResults"></div>
    </div>

    <div class="tag-cloud" id="tagCloud">
      <h3>🏷️ 熱門標籤</h3>
      <div class="tag-cloud-items" id="tagCloudItems"></div>
    </div>

    <% if (tagFilter) { %>
    <p style="color:var(--text-secondary);font-size:0.9rem;margin-bottom:16px;">
      篩選標籤：<strong style="color:var(--accent);"><%= tagFilter %></strong>
      <a href="<%= baseUrl %>/" style="color:var(--accent);margin-left:12px;">✕ 清除篩選</a>
    </p>
    <% } %>

    <section id="postsList">
      <% posts.forEach(post => { %>
      <div class="post-card">
        <h2><a href="<%= baseUrl %>/post/<%= post.id %>"><%= post.title %></a></h2>
        <div class="post-meta"><%= new Date(post.created_at).toLocaleDateString('zh-TW') %></div>
        <% if (post.tags && post.tags.length > 0) { %>
        <div class="post-tags">
          <% post.tags.forEach(tag => { %>
          <a href="<%= baseUrl %>/?tag=<%= tag %>" class="post-tag"><%= tag %></a>
          <% }) %>
        </div>
        <% } %>
        <div class="post-excerpt"><%- (post.html || '').replace(/<[^>]*>/g, '').substring(0, 150) %>...</div>
        <a href="<%= baseUrl %>/post/<%= post.id %>" class="read-more">閱讀更多 →</a>
      </div>
      <% }) %>
    </section>

    <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
      <a href="<%= baseUrl %>/?page=<%= currentPage - 1 %><%= tagFilter ? '&tag=' + encodeURIComponent(tagFilter) : '' %>">‹ 上一頁</a>
      <% } %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === currentPage) { %>
        <span class="current"><%= i %></span>
        <% } else { %>
        <a href="<%= baseUrl %>/?page=<%= i %><%= tagFilter ? '&tag=' + encodeURIComponent(tagFilter) : '' %>"><%= i %></a>
        <% } %>
      <% } %>
      <% if (currentPage < totalPages) { %>
      <a href="<%= baseUrl %>/?page=<%= currentPage + 1 %><%= tagFilter ? '&tag=' + encodeURIComponent(tagFilter) : '' %>">下一頁 ›</a>
      <% } %>
    </div>
    <% } %>
  </div>

  <script>
    const BASE = '<%= baseUrl %>';

    // Theme
    function getSystemTheme() { return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    function applyTheme(t) {
      document.documentElement.setAttribute('data-theme', t);
      localStorage.setItem('theme', t);
      const btn = document.getElementById('themeBtn');
      if (btn) btn.textContent = t === 'dark' ? '☀️ 淺色' : '🌙 深色';
    }
    window.toggleTheme = function() {
      const c = document.documentElement.getAttribute('data-theme');
      applyTheme(c === 'dark' ? 'light' : 'dark');
    };
    applyTheme(localStorage.getItem('theme') || getSystemTheme());
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
      if (!localStorage.getItem('theme')) applyTheme(e.matches ? 'dark' : 'light');
    });

    // Search Engine (client-side index)
    let searchIndex = null;
    let searchIndexPromise = null;
    async function getSearchIndex() {
      if (searchIndex) return searchIndex;
      if (searchIndexPromise) return searchIndexPromise;
      searchIndexPromise = (async () => {
        try {
          const res = await fetch(BASE + '/api/search-index');
          searchIndex = await res.json();
          return searchIndex;
        } catch { searchIndex = []; return searchIndex; }
      })();
      return searchIndexPromise;
    }
    getSearchIndex();

    let searchTimeout;
    window.doSearch = function(q) {
      clearTimeout(searchTimeout);
      const results = document.getElementById('searchResults');
      const list = document.getElementById('postsList');
      if (!q || q.length < 2) { results.innerHTML = ''; if (list) list.style.display = ''; return; }
      searchTimeout = setTimeout(async () => {
        try {
          const index = await getSearchIndex();
          const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
          const scored = index.map(item => {
            let score = 0;
            const title = (item.title || '').toLowerCase();
            const excerpt = (item.excerpt || '').toLowerCase();
            for (const term of terms) {
              if (title.includes(term)) score += 10;
              if (excerpt.includes(term)) score += 3;
            }
            return { item, score };
          }).filter(s => s.score > 0)
            .sort((a, b) => b.score - a.score)
            .slice(0, 20);
          if (list) list.style.display = 'none';
          results.innerHTML = scored.length
            ? scored.map(s => `
              <a href="${BASE}/post/${s.item.id}" class="search-result-item">
                <h4>${s.item.title}</h4>
                <p>${(s.item.excerpt || '').substring(0, 120)}</p>
              </a>`).join('')
            : '<p style="color:var(--text-secondary);font-size:0.9rem;padding:12px;">找不到相關文章</p>';
        } catch { results.innerHTML = ''; }
      }, 150);
    };

    // Tag Cloud
    async function loadTagCloud() {
      const c = document.getElementById('tagCloudItems');
      if (!c) return;
      try {
        const res = await fetch(BASE + '/api/tags');
        const tags = await res.json();
        if (tags.length === 0) { document.getElementById('tagCloud')?.remove(); return; }
        c.innerHTML = tags.map(t =>
          '<a href="' + BASE + '/?tag=' + encodeURIComponent(t.name) + '" class="tag-cloud-item">' + t.name + ' (' + t.count + ')</a>'
        ).join('');
      } catch {}
    }
    loadTagCloud();
  </script>
</body>
</html>
