<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>墨 - 網誌</title>
  <meta name="description" content="墨 - 紀錄瞬間的思緒。以專業視角解析技術與時事，在資訊爆炸的時代提供沉澱後的觀點。">
  <meta name="keywords" content="部落格,技術部落格,程式設計,網頁開發,JavaScript">
  <meta property="og:title" content="墨 - 網誌">
  <meta property="og:description" content="墨 - 紀錄瞬間的思緒。以專業視角解析技術與時事，在資訊爆炸的時代提供沉澱後的觀點。">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= baseUrl %>/">
  <link rel="canonical" href="<%= baseUrl %>/">
  <link rel="alternate" type="application/rss+xml" title="墨 - 網誌 RSS" href="<%= baseUrl %>/rss.xml">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="<%= baseUrl %>/sitemap.xml">
  <style>
    body.classic-bg {
      background-color: #f1f1f1;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      color: #333;
      margin: 0;
      padding: 20px 0;
    }

    .site-container {
      max-width: 940px;
      margin: 0 auto;
      background-color: #fff;
    }

    .site-header {
      padding: 30px 20px 0 20px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
    }
    .site-title {
      font-family: "Georgia", serif;
      font-size: 34px;
      font-weight: bold;
      margin: 0 0 10px 0;
      color: #000;
    }
    .site-description {
      font-style: italic;
      color: #777;
      margin: 0 0 10px 0;
      font-size: 14px;
    }
    .header-banner {
      width: 100%;
      height: 198px;
      object-fit: cover;
      display: block;
      margin-top: 20px;
    }

    .site-nav {
      background-color: #000;
    }
    .site-nav ul {
      list-style: none;
      margin: 0;
      padding: 0 20px;
      display: flex;
    }
    .site-nav li a {
      color: #fff;
      text-decoration: none;
      display: block;
      padding: 10px 20px;
      font-size: 14px;
    }
    .site-nav li a:hover {
      text-decoration: underline;
    }
    .dropdown {
      position: relative;
    }
    .dropdown-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: #000;
      flex-direction: column;
      min-width: 120px;
      z-index: 100;
      padding: 0;
      margin: 0;
      list-style: none;
    }
    .dropdown.active .dropdown-menu {
      display: flex;
    }
    .dropdown-menu li a {
      white-space: nowrap;
      padding: 10px 20px;
    }
    .dropdown > a .arrow {
      display: inline-block;
      transition: transform 0.25s ease;
      font-size: 0.7rem;
      margin-left: 4px;
    }
    .dropdown.active > a .arrow {
      transform: rotate(180deg);
    }

    .content-area {
      display: flex;
      padding: 40px 20px;
      gap: 50px;
    }
    .main-content {
      width: 68%;
    }
    .sidebar {
      width: 28%;
    }

    .post {
      margin-bottom: 40px;
      padding-bottom: 40px;
      border-bottom: 1px solid #eee;
    }
    .post:last-child {
      border-bottom: none;
    }
    .post-title {
      font-size: 28px;
      margin: 0 0 5px 0;
      color: #000;
    }
    .post-title a {
      color: #000;
      text-decoration: none;
    }
    .post-title a:hover {
      color: #0066cc;
    }
    .post-meta {
      color: #888;
      font-size: 12px;
      margin-bottom: 15px;
    }
    .post-excerpt {
      font-size: 14px;
      line-height: 1.7;
      color: #555;
      margin-bottom: 10px;
    }
    .post-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }
    .post-tag {
      padding: 4px 12px;
      background: #f1f1f1;
      border-radius: 12px;
      font-size: 12px;
      color: #888;
      text-decoration: none;
    }
    .post-tag:hover {
      color: #0066cc;
    }
    .read-more {
      color: #333;
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s;
    }
    .read-more:hover {
      color: #000;
      text-decoration: underline;
    }

    .sidebar .widget {
      margin-bottom: 28px;
      font-size: 13px;
      line-height: 1.7;
    }
    .sidebar .widget h3 {
      font-family: "Georgia", serif;
      font-size: 16px;
      font-weight: bold;
      color: #000;
      margin-bottom: 10px;
    }
    .sidebar .widget ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .sidebar .widget ul li {
      padding: 3px 0;
    }
    .sidebar .widget ul li a {
      color: #0066cc;
      text-decoration: none;
      font-size: 13px;
    }
    .sidebar .widget ul li a:hover {
      text-decoration: underline;
    }

    .search-form {
      display: flex;
      border: 1px solid #ccc;
    }
    .search-form .search-input {
      flex: 1;
      border: none;
      padding: 6px 8px;
      font-size: 13px;
      outline: none;
    }
    .search-form .search-btn {
      border: 1px solid #000;
      background: transparent;
      color: #000;
      padding: 6px 12px;
      cursor: pointer;
      font-size: 13px;
      transition: background 0.2s, color 0.2s;
    }
    .search-form .search-btn:hover {
      background: #000;
      color: #fff;
    }

    .tag-list li a {
      color: #0066cc;
      text-decoration: none;
    }
    .tag-list li a:hover {
      text-decoration: underline;
    }

    .pagination {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 30px;
    }
    .pagination a, .pagination span {
      padding: 6px 14px;
      border: 1px solid #ccc;
      text-decoration: none;
      color: #888;
      font-size: 14px;
    }
    .pagination a:hover {
      background: #f1f1f1;
    }
    .pagination .current {
      background: #000;
      color: #fff;
      border-color: #000;
    }

    .site-footer {
      border-top: 4px solid #000;
      padding: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      color: #666;
    }
    .site-footer strong {
      font-size: 16px;
      color: #000;
    }
    .site-footer a {
      color: #888;
      text-decoration: none;
    }
    .site-footer a:hover {
      color: #0066cc;
      text-decoration: underline;
    }

    .filter-bar {
      color: #888;
      font-size: 13px;
      margin-bottom: 20px;
    }
    .filter-bar a {
      color: #0066cc;
      margin-left: 8px;
    }

    .tag-cloud-items {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tag-cloud-items a {
      padding: 4px 12px;
      background: #f1f1f1;
      border-radius: 12px;
      font-size: 12px;
      color: #888;
      text-decoration: none;
    }
    .tag-cloud-items a:hover {
      color: #0066cc;
    }

    .market-section { margin-bottom: 12px; }
    .market-section-title { font-size: 12px; font-weight: bold; color: #555; margin-bottom: 4px; padding-bottom: 2px; border-bottom: 1px solid #eee; }
    .market-item { display: flex; justify-content: space-between; align-items: center; padding: 3px 0; font-size: 12px; }
    .market-item .sym { font-weight: bold; color: #333; }
    .market-item .price { color: #666; }
    .market-item .change { font-weight: bold; padding: 1px 6px; border-radius: 3px; font-size: 11px; }
    .market-item .change.up { color: #fff; background: #e74c3c; }
    .market-item .change.down { color: #fff; background: #27ae60; }

    @media (max-width: 768px) {
      body.classic-bg { padding: 10px 0; }
      .content-area { flex-direction: column; padding: 20px 16px; gap: 20px; }
      .main-content, .sidebar { width: 100%; }
      .site-description { text-align: right; }
      .site-title { font-size: 26px; }
      .header-banner { height: 120px; }
      .site-nav ul { padding: 0 10px; flex-wrap: wrap; }
      .site-nav li a { padding: 8px 12px; font-size: 13px; }
    .dropdown-menu { position: static; display: none; flex-direction: row; flex-wrap: wrap; background: transparent; min-width: auto; }
    .dropdown.active .dropdown-menu { display: flex; }
    .dropdown-menu li a { padding: 8px 12px; font-size: 13px; }
      .site-footer { flex-direction: column; gap: 8px; text-align: center; }
    }
  </style>
</head>
<body class="classic-bg">
  <div class="site-container">

    <header class="site-header">
      <h1 class="site-title">紀錄瞬間的思緒</h1>
      <p class="site-description">以專業視角解析技術與時事，在資訊爆炸的時代提供沉澱後的觀點。</p>
      <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=940&h=198&fit=crop&q=80" alt="水墨意境橫幅" class="header-banner">
    </header>

    <%- include('partials/navbar') %>

    <div class="content-area">
      <main class="main-content">

        <% if (tagFilter) { %>
        <div class="filter-bar">
          篩選標籤：<strong><%= tagFilter %></strong>
          <a href="<%= baseUrl %>/">✕ 清除篩選</a>
        </div>
        <% } %>

        <div id="searchResults"></div>

        <% posts.forEach(post => { %>
        <article class="post">
          <h2 class="post-title"><a href="<%= baseUrl %>/post/<%= post.id %>"><%= post.title %></a></h2>
          <div class="post-meta">Posted on <%= new Date(post.created_at).toLocaleDateString('zh-TW') %></div>
          <% if (post.tags && post.tags.length > 0) { %>
          <div class="post-tags">
            <% post.tags.forEach(tag => { %>
            <a href="<%= baseUrl %>/?tag=<%= tag %>" class="post-tag"><%= tag %></a>
            <% }) %>
          </div>
          <% } %>
          <div class="post-excerpt"><%= (post.html || '').replace(/<[^>]*>/g, '').substring(0, 200) %></div>
          <a href="<%= baseUrl %>/post/<%= post.id %>" class="read-more">閱讀更多 &rarr;</a>
        </article>
        <% }) %>

        <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %>
          <a href="<%= baseUrl %>/?page=<%= currentPage - 1 %><%= tagFilter ? '&tag=' + encodeURIComponent(tagFilter) : '' %>">‹ 上一頁</a>
          <% } %>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
            <span class="current"><%= i %></span>
            <% } else { %>
            <a href="<%= baseUrl %>/?page=<%= i %><%= tagFilter ? '&tag=' + encodeURIComponent(tagFilter) : '' %>"><%= i %></a>
            <% } %>
          <% } %>
          <% if (currentPage < totalPages) { %>
          <a href="<%= baseUrl %>/?page=<%= currentPage + 1 %><%= tagFilter ? '&tag=' + encodeURIComponent(tagFilter) : '' %>">下一頁 &rsaquo;</a>
          <% } %>
        </div>
        <% } %>

      </main>

      <aside class="sidebar">
        <div class="widget">
          <div class="search-form">
            <input type="text" id="sidebarSearch" placeholder="搜尋文章..." class="search-input">
            <button class="search-btn" onclick="doSearch(document.getElementById('sidebarSearch').value)">Search</button>
          </div>
        </div>
        
        <div class="widget">
          <h3>熱門標籤</h3>
          <div class="tag-cloud-items" id="tagCloudItems"></div>
        </div>

        <div class="widget market-widget">
          <h3>📊 市場行情</h3>
          <div id="marketLoading" style="font-size:12px;color:#888;">載入中...</div>
          <div id="marketError" style="font-size:12px;color:#c00;display:none;"></div>
          <div id="marketContent" style="display:none;">
            <div class="market-section">
              <a href="<%= baseUrl %>/market.html#crypto" class="market-section-title" style="text-decoration:none;cursor:pointer;">加密貨幣 ›</a>
              <div id="cryptoList"></div>
            </div>
            <div class="market-section">
              <a href="<%= baseUrl %>/market.html#tw-stock" class="market-section-title" style="text-decoration:none;cursor:pointer;">台股 ›</a>
              <div id="twStockList"></div>
            </div>
            <div class="market-section">
              <a href="<%= baseUrl %>/market.html#us-stocks" class="market-section-title" style="text-decoration:none;cursor:pointer;">美股 ›</a>
              <div id="usStockList"></div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <footer class="site-footer">
      <div class="footer-left">
        <strong>墨</strong>
      </div>
      <div class="footer-right">
        &copy; <%= new Date().getFullYear() %> 墨. All rights reserved.
      </div>
    </footer>

  </div>

  <script>
    const BASE = '<%= baseUrl %>';

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const active = document.activeElement;
        if (active && active.classList.contains('search-input')) {
          window.doSearch(active.value);
        }
      }
    });

    // Search Engine (client-side index)
    let searchIndex = null;
    let searchIndexPromise = null;
    async function getSearchIndex() {
      if (searchIndex) return searchIndex;
      if (searchIndexPromise) return searchIndexPromise;
      searchIndexPromise = (async () => {
        try {
          const res = await fetch(BASE + '/api/search-index');
          searchIndex = await res.json();
          return searchIndex;
        } catch { searchIndex = []; return searchIndex; }
      })();
      return searchIndexPromise;
    }
    getSearchIndex();

    let searchTimeout;
    window.doSearch = function(q) {
      clearTimeout(searchTimeout);
      const results = document.getElementById('searchResults');
      if (!q || q.length < 2) { results.innerHTML = ''; return; }
      searchTimeout = setTimeout(async () => {
        try {
          const index = await getSearchIndex();
          const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
          const scored = index.map(item => {
            let score = 0;
            const title = (item.title || '').toLowerCase();
            const excerpt = (item.excerpt || '').toLowerCase();
            for (const term of terms) {
              if (title.includes(term)) score += 10;
              if (excerpt.includes(term)) score += 3;
            }
            return { item, score };
          }).filter(s => s.score > 0)
            .sort((a, b) => b.score - a.score)
            .slice(0, 20);
          results.innerHTML = scored.length
            ? scored.map(s => `
              <div style="padding:8px 0;border-bottom:1px solid #eee;">
                <a href="${BASE}/post/${s.item.id}" style="color:#333;text-decoration:none;font-weight:bold;">${s.item.title}</a>
                <p style="margin:4px 0 0;font-size:12px;color:#888;">${(s.item.excerpt || '').substring(0, 120)}</p>
              </div>`).join('')
            : '<p style="font-size:12px;color:#888;padding:8px 0;">找不到相關文章</p>';
        } catch { results.innerHTML = ''; }
      }, 150);
    };

    // Tag Cloud
    async function loadTagCloud() {
      const c = document.getElementById('tagCloudItems');
      if (!c) return;
      try {
        const res = await fetch(BASE + '/api/tags');
        const tags = await res.json();
        c.innerHTML = tags.map(t =>
          '<a href="' + BASE + '/?tag=' + encodeURIComponent(t.name) + '" class="tag-cloud-item">' + t.name + ' (' + t.count + ')</a>'
        ).join('');
      } catch {}
    }
    loadTagCloud();

    // Market Data
    async function loadMarketData() {
      const loading = document.getElementById('marketLoading');
      const error = document.getElementById('marketError');
      const content = document.getElementById('marketContent');
      if (!loading) return;
      try {
        const [crypto, twStock, usStocks] = await Promise.all([
          fetch(BASE + '/api/market/crypto').then(r => r.json()),
          fetch(BASE + '/api/market/tw-stock').then(r => r.json()),
          fetch(BASE + '/api/market/us-stocks').then(r => r.json())
        ]);
        loading.style.display = 'none';
        content.style.display = 'block';

        // Crypto
        const cryptoList = document.getElementById('cryptoList');
        if (Array.isArray(crypto) && crypto.length) {
          cryptoList.innerHTML = crypto.map(c => {
            const cls = c.change >= 0 ? 'up' : 'down';
            return '<div class="market-item"><span class="sym">' + c.symbol + '</span><span class="price">$' + c.price.toLocaleString() + '</span><span class="change ' + cls + '">' + (c.change >= 0 ? '+' : '') + c.change.toFixed(2) + '%</span></div>';
          }).join('');
        } else {
          cryptoList.innerHTML = '<div style="font-size:11px;color:#999;">暫無資料</div>';
        }

        function renderItems(list, data, max) {
          const arr = Array.isArray(data) ? data : (data ? [data] : []);
          const items = arr.slice(0, max || arr.length);
          if (items.length) {
            list.innerHTML = items.map(s => {
              const cls = s.change >= 0 ? 'up' : 'down';
              const name = s.label || s.symbol || '';
              return '<div class="market-item"><span class="sym">' + name + '</span><span class="price">' + (s.price != null ? s.price.toLocaleString(undefined,{maximumFractionDigits:2}) : '-') + '</span><span class="change ' + cls + '">' + (s.change >= 0 ? '+' : '') + (s.change != null ? s.change.toFixed(2) : '0') + '%</span></div>';
            }).join('');
          } else {
            list.innerHTML = '<div style="font-size:11px;color:#999;">暫無資料</div>';
          }
        }

        renderItems(document.getElementById('twStockList'), twStock, 5);
        renderItems(document.getElementById('usStockList'), usStocks, 5);
      } catch (err) {
        loading.style.display = 'none';
        error.style.display = 'block';
        error.textContent = '行情資料暫時無法取得';
      }
    }
    loadMarketData();
  </script>
</body>
</html>
