<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> - <%= t('site_name') %></title>
  <meta name="description" content="<%= (post.meta_description || post.summary || '').substring(0, 160) || (post.content || '').replace(/<[^>]*>/g, '').substring(0, 160) %>">
  <meta name="keywords" content="<%= post.tags ? post.tags.join(',') : '' %>">
  <meta property="og:title" content="<%= post.title %> - <%= t('site_name') %>">
  <meta property="og:description" content="<%= (post.meta_description || post.summary || '').substring(0, 160) || t('site_desc') %>">
  <meta property="og:type" content="article">
  <meta property="og:url" content="<%= baseUrl %>/post/<%= post.id %>">
  <meta property="article:published_time" content="<%= new Date(post.created_at).toISOString() %>">
  <meta property="article:modified_time" content="<%= new Date(post.updated_at || post.created_at).toISOString() %>">
  <meta property="article:author" content="<%= t('site_name') %>">
  <% (post.tags || []).forEach(tag => { %>
  <meta property="article:tag" content="<%= tag %>">
  <% }) %>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= post.title %> - <%= t('site_name') %>">
  <meta name="twitter:description" content="<%= (post.meta_description || post.summary || '').substring(0, 160) || t('site_desc') %>">
  <link rel="canonical" href="<%= baseUrl %>/post/<%= post.id %>">
  <link rel="alternate" type="application/rss+xml" title="<%= t('site_rss_title') %>" href="<%= baseUrl %>/rss.xml">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="<%= baseUrl %>/sitemap.xml">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "<%= post.title %>",
    "description": "<%= (post.summary || '').replace(/"/g, '&quot;') || t('site_desc') %>",
    "author": { "@type": "Person", "name": "<%= t('site_name') %>" },
    "datePublished": "<%= new Date(post.created_at).toISOString() %>",
    "dateModified": "<%= new Date(post.updated_at || post.created_at).toISOString() %>",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "<%= baseUrl %>/post/<%= post.id %>" }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.css" rel="stylesheet">
  <style>
    :root {
      --bg: #f2f0e9; --bg-card: rgba(255,255,255,0.8); --text: #1a1a1a; --text-secondary: #555;
      --border: rgba(0,0,0,0.1); --accent: #000; --toc-bg: rgba(255,255,255,0.85);
      --code-bg: #1e1e1e; --code-text: #d4d4d4; --shadow: rgba(0,0,0,0.08);
      --hover-bg: rgba(0,0,0,0.05); --tag-bg: #e8e6df;
    }
    [data-theme="dark"] {
      --bg: #1a1a1a; --bg-card: rgba(30,30,30,0.9); --text: #e0e0e0; --text-secondary: #999;
      --border: rgba(255,255,255,0.1); --accent: #fff; --toc-bg: rgba(30,30,30,0.95);
      --code-bg: #0d0d0d; --code-text: #d4d4d4; --shadow: rgba(0,0,0,0.3);
      --hover-bg: rgba(255,255,255,0.08); --tag-bg: #2a2a2a;
    }
    html { scroll-behavior: smooth; }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0; font-family: 'Noto Serif TC', serif;
      background: var(--bg); color: var(--text);
      transition: background 0.3s, color 0.3s;
      overflow-x: hidden;
    }
    /* Reading Progress Bar */
    #progressBar {
      position: fixed; top: 0; left: 0; height: 3px;
      background: linear-gradient(90deg, #667eea, #764ba2);
      z-index: 9999; width: 0%; transition: width 0.1s;
    }
    /* Top Bar */
    .top-bar {
      position: fixed; top: 3px; left: 0; right: 0; z-index: 999;
      display: flex; justify-content: flex-end; align-items: center;
      padding: 8px 24px; gap: 12px;
      background: #000; border-bottom: 1px solid #333;
    }
    .top-bar a { color: #ccc; text-decoration: none; font-size: 0.85rem; }
    .top-bar a:hover { color: #fff; }
    .top-bar .nav-brand { color: #fff; font-weight: 700; letter-spacing: 2px; }
    .theme-toggle, .search-toggle {
      background: none; border: 1px solid #555; border-radius: 20px;
      padding: 4px 12px; cursor: pointer; font-size: 0.85rem;
      color: #ccc; transition: 0.2s; box-shadow: none; margin: 0;
    }
    .theme-toggle:hover, .search-toggle:hover { background: #333; color: #fff; transform: none; }
    /* Search Overlay */
    .search-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5); z-index: 10000;
      display: none; justify-content: center; padding-top: 15vh;
    }
    .search-overlay.active { display: flex; }
    .search-panel {
      background: var(--bg-card); backdrop-filter: blur(12px);
      width: 90%; max-width: 600px; max-height: 70vh;
      border-radius: 12px; padding: 24px;
      box-shadow: 0 20px 60px var(--shadow); overflow-y: auto;
    }
    .search-panel input {
      width: 100%; padding: 12px 16px; border: 1px solid var(--border);
      border-radius: 8px; font-size: 1.1rem;
      background: var(--bg); color: var(--text);
      font-family: 'Noto Serif TC', serif; outline: none;
    }
    .search-panel input:focus { border-color: var(--accent); }
    .search-results { margin-top: 16px; }
    .search-result-item {
      padding: 12px; border-bottom: 1px solid var(--border);
      cursor: pointer; transition: 0.2s;
    }
    .search-result-item:hover { background: var(--hover-bg); }
    .search-result-item h4 { margin: 0 0 4px; font-size: 1rem; }
    .search-result-item p { margin: 0; font-size: 0.85rem; color: var(--text-secondary); }
    /* Layout */
    .layout { display: flex; max-width: 1200px; margin: 60px auto 0; padding: 0 20px; gap: 30px; }
    /* Floating TOC */
    .toc-sidebar {
      position: sticky; top: 70px; width: 220px; flex-shrink: 0;
      max-height: calc(100vh - 90px); overflow-y: auto;
      padding: 16px; border-radius: 8px;
      background: var(--toc-bg); backdrop-filter: blur(8px);
      border: 1px solid var(--border);
    }
    .toc-sidebar::-webkit-scrollbar { width: 3px; }
    .toc-sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
    .toc-title { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; color: var(--text-secondary); margin-bottom: 12px; font-weight: 700; }
    .toc-item { display: block; padding: 4px 8px; font-size: 0.85rem; color: var(--text-secondary); text-decoration: none; border-left: 2px solid transparent; margin-bottom: 2px; transition: 0.2s; }
    .toc-item:hover { color: var(--text); border-left-color: var(--text-secondary); }
    .toc-item.active { color: var(--accent); border-left-color: var(--accent); font-weight: 700; }
    .toc-item.h3 { padding-left: 20px; font-size: 0.8rem; }
    /* Main Content */
    .post-content { flex: 1; min-width: 0; max-width: 720px; }
    .post-header { margin-bottom: 32px; }
    .post-header h1 { font-size: 2rem; margin: 0 0 8px; line-height: 1.4; }
    .post-meta { font-size: 0.85rem; color: var(--text-secondary); display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }
    .post-meta .tags { display: flex; gap: 6px; flex-wrap: wrap; }
    .post-meta .tag { display: inline-block; padding: 4px 12px; background: var(--tag-bg); border-radius: 12px; font-size: 0.75rem; color: var(--text-secondary); text-decoration: none; }
    /* Article Body */
    .article-body { line-height: 1.9; font-size: 1.05rem; }
    .article-body h2 { margin: 40px 0 16px; font-size: 1.5rem; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
    .article-body h3 { margin: 32px 0 12px; font-size: 1.2rem; }
    .article-body p { margin: 0 0 16px; }
    .article-body img { max-width: 100%; border-radius: 8px; margin: 16px 0; }
    .article-body blockquote { margin: 16px 0; padding: 12px 20px; border-left: 4px solid var(--accent); background: var(--tag-bg); font-style: italic; }
    .article-body ul, .article-body ol { padding-left: 24px; margin: 0 0 16px; }
    .article-body li { margin-bottom: 8px; }
    /* Annotation popover */
    .annotation { border-bottom: 1px dashed var(--accent); cursor: help; position: relative; }
    .annotation-popup {
      position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
      background: var(--text); color: var(--bg); padding: 8px 14px; border-radius: 6px;
      font-size: 0.85rem; white-space: nowrap; max-width: 280px; white-space: normal;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2); opacity: 0; pointer-events: none;
      transition: opacity 0.2s, transform 0.2s; z-index: 100; line-height: 1.5;
    }
    .annotation:hover .annotation-popup { opacity: 1; transform: translateX(-50%) translateY(-4px); }
    /* Code Blocks */
    .code-block-wrapper {
      position: relative; margin: 20px 0; border-radius: 8px; overflow: hidden;
      border: 1px solid var(--border);
    }
    .code-block-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 6px 14px; background: #2d2d2d; color: #999; font-size: 0.8rem;
      font-family: 'JetBrains Mono', monospace;
    }
    .code-block-header .filename { color: #ccc; }
    .copy-btn {
      background: none; border: 1px solid #555; color: #ccc; padding: 2px 10px;
      border-radius: 4px; cursor: pointer; font-size: 0.75rem; box-shadow: none; margin: 0;
      transition: 0.2s;
    }
    .copy-btn:hover { background: #444; transform: none; }
    .copy-btn.copied { border-color: #4caf50; color: #4caf50; }
    .code-block-wrapper pre { margin: 0; border-radius: 0; }
    .code-block-wrapper pre[class*="language-"] { margin: 0; border-radius: 0; }
    /* Code Playground */
    .playground { margin: 24px 0; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .playground-tabs { display: flex; border-bottom: 1px solid var(--border); }
    .playground-tab { padding: 8px 16px; cursor: pointer; font-size: 0.8rem; border-bottom: 2px solid transparent; transition: 0.2s; color: var(--text-secondary); }
    .playground-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
    .playground-editor { display: none; }
    .playground-editor.active { display: block; }
    .playground-editor textarea {
      width: 100%; min-height: 120px; padding: 12px; border: none;
      background: #1e1e1e; color: #d4d4d4; font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem; resize: vertical; outline: none;
    }
    .playground-output {
      padding: 16px; background: var(--bg-card); border-top: 1px solid var(--border);
      min-height: 80px;
    }
    .playground-output iframe { width: 100%; border: none; }
    .playground-run {
      display: block; width: 100%; padding: 10px; background: var(--accent);
      color: var(--bg); border: none; cursor: pointer; font-size: 0.9rem;
      font-family: 'Noto Serif TC', serif; transition: 0.2s; box-shadow: none; margin: 0;
    }
    .playground-run:hover { opacity: 0.8; transform: none; }
    /* AI Summary */
    .ai-summary {
      margin: 24px 0; padding: 20px; background: var(--tag-bg);
      border-left: 4px solid #667eea; border-radius: 0 8px 8px 0;
    }
    .ai-summary-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 2px; color: #667eea; font-weight: 700; margin-bottom: 8px; }
    .ai-summary p { margin: 0; line-height: 1.7; font-size: 0.95rem; color: var(--text-secondary); }
    /* Related Posts */
    .related-posts { margin: 40px 0; padding: 24px; background: var(--bg-card); border-radius: 8px; border: 1px solid var(--border); }
    .related-posts h3 { margin: 0 0 16px; font-size: 1.1rem; }
    .related-list { display: grid; gap: 12px; }
    .related-item { padding: 12px; border-radius: 6px; transition: 0.2s; text-decoration: none; display: block; }
    .related-item:hover { background: var(--hover-bg); }
    .related-item h4 { margin: 0 0 4px; font-size: 0.95rem; color: var(--text); }
    .related-item p { margin: 0; font-size: 0.8rem; color: var(--text-secondary); }
    /* Tag Cloud */
    .tag-cloud { margin: 40px 0; }
    .tag-cloud h3 { margin: 0 0 16px; font-size: 1.1rem; }
    .tag-cloud-items { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag-cloud-item { padding: 4px 14px; background: var(--tag-bg); border-radius: 20px; text-decoration: none; color: var(--text-secondary); font-size: 0.85rem; transition: 0.2s; }
    .tag-cloud-item:hover { background: var(--accent); color: var(--bg); }
    /* Comments Section */
    .comments-section { margin: 40px 0; }
    .comments-section h3 { margin: 0 0 16px; font-size: 1.1rem; }
    .comment-card { padding: 16px; border-bottom: 1px solid var(--border); }
    .comment-author { font-weight: 700; font-size: 0.9rem; margin-bottom: 4px; }
    .comment-text { font-size: 0.95rem; line-height: 1.6; }
    .comment-date { font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px; }
    .comment-form { display: flex; gap: 12px; margin-top: 16px; }
    .comment-form input { flex: 1; padding: 10px 14px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--text); font-family: 'Noto Serif TC', serif; }
    .comment-form button { padding: 10px 20px; background: var(--accent); color: var(--bg); border: none; border-radius: 6px; cursor: pointer; box-shadow: none; margin: 0; }
    /* Social Share */
    .share-section { margin: 32px 0; padding: 20px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); text-align: center; }
    .share-section span { font-size: 0.9rem; color: var(--text-secondary); margin-right: 12px; }
    .share-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 18px; border-radius: 20px; text-decoration: none;
      font-size: 0.85rem; margin: 0 4px; transition: 0.2s;
      border: 1px solid var(--border); color: var(--text-secondary); background: var(--bg-card);
    }
    .share-btn:hover { background: var(--hover-bg); color: var(--text); }
    .share-btn.facebook:hover { background: #1877f2; color: #fff; border-color: #1877f2; }
    .share-btn.line:hover { background: #06c755; color: #fff; border-color: #06c755; }
    .share-btn.twitter:hover { background: #000; color: #fff; border-color: #000; }
    /* Reading time */
    .reading-time { color: var(--text-secondary); font-size: 0.85rem; display: inline-flex; align-items: center; gap: 4px; }
    /* Article Collapse */
    .article-collapse { position: relative; overflow: hidden; transition: max-height 0.4s ease; }
    .article-collapse.collapsed { max-height: 600px; }
    .article-fade {
      position: absolute; bottom: 0; left: 0; right: 0; height: 120px;
      background: linear-gradient(transparent, var(--bg));
      pointer-events: none; transition: opacity 0.3s ease;
    }
    .article-collapse:not(.collapsed) .article-fade { opacity: 0; }
    .article-toggle {
      display: none; width: 100%; padding: 12px; margin-top: 0;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 0 0 8px 8px; cursor: pointer; font-size: 0.9rem;
      color: var(--accent); font-family: inherit; transition: 0.2s; text-align: center;
    }
    .article-toggle:hover { background: var(--hover-bg); }
    .article-toggle.visible { display: block; }
    /* Footer */
    .site-footer { border-top: 4px solid #000; padding: 20px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #666; margin-top: 40px; }
    .site-footer strong { font-size: 16px; color: #000; }
    .footer-desc { font-size: 12px; color: #888; margin-left: 8px; }
    .footer-right { text-align: right; }
    .footer-links { margin-left: 12px; }
    .footer-links a { color: #888; text-decoration: none; margin-left: 8px; }
    .footer-links a:hover { color: #0066cc; text-decoration: underline; }
    .site-footer a { color: #888; text-decoration: none; }
    .site-footer a:hover { color: #0066cc; text-decoration: underline; }

    /* Newsletter */
    .newsletter-box { margin: 40px 0; padding: 24px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; text-align: center; }
    .newsletter-box h3 { margin: 0 0 8px; font-size: 1.1rem; }
    .newsletter-box p { margin: 0 0 16px; font-size: 0.9rem; color: var(--text-secondary); }
    .newsletter-form { display: flex; gap: 8px; max-width: 400px; margin: 0 auto; }
    .newsletter-form input { flex: 1; padding: 10px 14px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--text); font-family: 'Noto Serif TC', serif; }
    .newsletter-form button { padding: 10px 20px; background: var(--accent); color: var(--bg); border: none; border-radius: 6px; cursor: pointer; box-shadow: none; margin: 0; }
    /* GitHub Discussions embed */
    .github-discussions { margin: 40px 0; }
    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
    /* Responsive */
    @media (max-width: 860px) {
      .toc-sidebar { display: none; }
      .layout { padding: 0 16px; }
    }
    @media (max-width: 600px) {
      .site-footer { flex-direction: column; gap: 8px; text-align: center; }
      .footer-right { text-align: center; }
      .footer-desc { display: none; }
      .top-bar { flex-wrap: wrap; gap: 6px; padding: 8px 12px; }
      .share-btn { margin: 4px; }
    }
  </style>
</head>
<body>
  <div id="progressBar"></div>

  <div class="top-bar">
    <div class="top-lang" style="display:flex;gap:4px;align-items:center;font-size:0.8rem;">
      <a href="<%= baseUrl %>/lang/zh-TW" style="<%= lang === 'zh-TW' ? 'color:#fff;font-weight:bold;' : '' %>">繁體中文</a>
      <span style="color:#555;">|</span>
      <a href="<%= baseUrl %>/lang/en" style="<%= lang === 'en' ? 'color:#fff;font-weight:bold;' : '' %>">English</a>
      <span style="color:#555;">|</span>
      <a href="<%= baseUrl %>/lang/ja" style="<%= lang === 'ja' ? 'color:#fff;font-weight:bold;' : '' %>">日本語</a>
    </div>
    <a href="<%= baseUrl %>/" class="nav-brand" style="font-weight:700;letter-spacing:2px;"><%= t('post_topbar_brand') %></a>
    <a href="<%= baseUrl %>/">📝 <%= t('post_topbar_blog') %></a>
    <a href="<%= baseUrl %>/about">ℹ️ <%= t('post_topbar_about') %></a>
    <a href="<%= baseUrl %>/contact">✉️ <%= t('post_topbar_contact') %></a>
    <a href="<%= baseUrl %>/post/<%= post.id %>/edit">✏️ <%= t('post_topbar_edit') %></a>
    <button class="search-toggle" onclick="toggleSearch()">🔍 <%= t('post_topbar_search') %></button>
    <button class="theme-toggle" onclick="toggleTheme()" id="themeBtn">🌙 <%= t('post_topbar_dark') %></button>
    <button class="theme-toggle" onclick="deletePost()" style="color:#e74c3c;">🗑 <%= t('post_topbar_delete') %></button>
  </div>

  <!-- Search Overlay -->
  <div class="search-overlay" id="searchOverlay" onclick="if(event.target===this)closeSearch()">
    <div class="search-panel">
      <input type="text" id="searchInput" placeholder="<%= t('post_search_placeholder') %>" oninput="doSearch(this.value)" autofocus>
      <div class="search-results" id="searchResults"></div>
    </div>
  </div>

  <div class="layout">
    <!-- Floating TOC -->
    <nav class="toc-sidebar" id="tocSidebar">
      <div class="toc-title"><%= t('post_toc_title') %></div>
      <div id="tocList"></div>
    </nav>

    <!-- Main Content -->
    <article class="post-content">
      <header class="post-header">
        <h1><%= post.title %></h1>
        <div class="post-meta">
          <span><%= new Date(post.created_at).toLocaleDateString(lang === 'en' ? 'en-US' : lang === 'ja' ? 'ja-JP' : 'zh-TW') %></span>
          <% if (post.updated_at && post.updated_at !== post.created_at) { %>
          <span style="color:var(--text-secondary);font-size:0.8rem;">（<%= t('post_updated') %>：<%= new Date(post.updated_at).toLocaleDateString(lang === 'en' ? 'en-US' : lang === 'ja' ? 'ja-JP' : 'zh-TW') %>）</span>
          <% } %>
          <span class="reading-time" id="readingTime">⏱ <span id="readTimeMinutes">?</span> <%= t('post_reading_time') %></span>
          <span>👤 <%= t('post_author') %></span>
          <span>👁 <span id="viewCount">?</span></span>
          <% if (post.tags && post.tags.length > 0) { %>
          <div class="tags">
            <% post.tags.forEach(tag => { %>
            <a href="<%= baseUrl %>/?tag=<%= tag %>" class="tag"><%= tag %></a>
            <% }) %>
          </div>
          <% } %>
        </div>
      </header>

      <!-- AI Summary -->
      <% if (post.summary) { %>
      <div class="ai-summary">
        <div class="ai-summary-label">📋 <%= t('post_ai_summary') %></div>
        <p><%= post.summary %></p>
      </div>
      <% } %>

      <!-- Article Body -->
      <div class="article-collapse" id="articleCollapse">
        <div class="article-body" id="articleBody">
          <%- post.content %>
        </div>
        <div class="article-fade" id="articleFade"></div>
      </div>
      <button class="article-toggle" id="articleToggle" onclick="toggleArticle()"><%= t('post_show_more') %></button>

      <!-- Share -->
      <div class="share-section">
        <span><%= t('post_share_title') %></span>
        <a class="share-btn facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + '/post/' + post.id) %>" target="_blank" rel="noopener">📘 <%= t('post_share_facebook') %></a>
        <a class="share-btn line" href="https://social-plugins.line.me/lineit/share?url=<%= encodeURIComponent(baseUrl + '/post/' + post.id) %>" target="_blank" rel="noopener">💬 <%= t('post_share_line') %></a>
        <a class="share-btn twitter" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title + ' - ' + t('site_name')) %>&url=<%= encodeURIComponent(baseUrl + '/post/' + post.id) %>" target="_blank" rel="noopener"> 𝕏 <%= t('post_share_twitter') %></a>
      </div>

      <!-- Playground (if code present) -->
      <div id="playgroundContainer"></div>

      <!-- Tag Cloud -->
      <div class="tag-cloud" id="tagCloudContainer">
        <h3>🏷️ <%= t('post_tag_cloud') %></h3>
        <div class="tag-cloud-items" id="tagCloudItems"></div>
      </div>

      <!-- Related Posts -->
      <% if (relatedPosts && relatedPosts.length > 0) { %>
      <div class="related-posts">
        <h3>📌 <%= t('post_related_title') %></h3>
        <div class="related-list">
          <% relatedPosts.forEach(rp => { %>
          <a href="<%= baseUrl %>/post/<%= rp.id %>" class="related-item">
            <h4><%= rp.title %></h4>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Comments -->
      <div class="comments-section" id="commentsSection">
        <h3>💬 <%= t('post_comments_title') %></h3>
        <div id="commentsList"></div>
        <div class="comment-form">
          <input type="text" id="commentName" placeholder="<%= t('post_comment_name_placeholder') %>">
          <input type="text" id="commentInput" placeholder="<%= t('post_comment_placeholder') %>">
          <button onclick="postComment()"><%= t('post_comment_btn') %></button>
        </div>
      </div>

      <!-- GitHub Discussions -->
      <div class="github-discussions">
        <h3>📢 <%= t('post_github_discussions') %></h3>
        <div id="githubDiscussions">
          <p style="color:var(--text-secondary);font-size:0.9rem;">
            <%= t('post_github_desc') %>
            <a href="https://github.com/settings/apps" target="_blank" style="color:var(--accent);"><%= t('post_github_settings') %></a>
            <%= t('post_github_code') %>
          </p>
        </div>
      </div>

      <!-- Newsletter -->
      <div class="newsletter-box">
        <h3>📬 <%= t('post_newsletter_title') %></h3>
        <p><%= t('post_newsletter_desc') %></p>
        <div class="newsletter-form">
          <input type="email" id="newsletterEmail" placeholder="<%= t('post_newsletter_placeholder') %>">
          <button onclick="subscribeNewsletter()"><%= t('post_newsletter_btn') %></button>
        </div>
        <p id="newsletterMsg" style="font-size:0.8rem;margin-top:8px;"></p>
      </div>
    </article>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js" data-autoloader-path="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/"></script>
  <!-- Back to top -->
  <button id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" style="position:fixed;bottom:24px;right:24px;width:44px;height:44px;border-radius:50%;background:var(--text);color:var(--bg);border:none;cursor:pointer;font-size:1.2rem;z-index:999;box-shadow:0 2px 12px rgba(0,0,0,0.2);display:none;transition:0.3s;padding:0;margin:0;">↑</button>
  <script>
    window.BASE_URL = '<%= baseUrl %>';
    window.addEventListener('scroll', () => {
      document.getElementById('backToTop').style.display = window.scrollY > 400 ? 'block' : 'none';
    });

    // View count
    (function() {
      fetch(BASE_URL + '/api/posts/<%= post.id %>/views')
        .then(r => r.json())
        .then(d => { document.getElementById('viewCount').textContent = d.views; })
        .catch(() => { document.getElementById('viewCount').textContent = '0'; });
    })();

    // Reading time & article collapse
    (function() {
      const body = document.getElementById('articleBody');
      if (body) {
        const text = body.textContent || '';
        const charCount = text.replace(/\s/g, '').length;
        const minutes = Math.max(1, Math.ceil(charCount / 500));
        document.getElementById('readTimeMinutes').textContent = minutes;
      }
      var collapse = document.getElementById('articleCollapse');
      var toggle = document.getElementById('articleToggle');
      if (collapse && toggle && collapse.scrollHeight > 600) {
        collapse.classList.add('collapsed');
        toggle.classList.add('visible');
      }
    })();
    var articleExpanded = false;
    function toggleArticle() {
      var collapse = document.getElementById('articleCollapse');
      var toggle = document.getElementById('articleToggle');
      if (!collapse) return;
      if (articleExpanded) {
        collapse.classList.add('collapsed');
        toggle.textContent = '顯示更多 ▾';
      } else {
        collapse.classList.remove('collapsed');
        toggle.textContent = '收合 ▴';
      }
      articleExpanded = !articleExpanded;
    }

    function deletePost() {
      if (!confirm('⚠️ <%= t('post_delete_confirm') %>')) return;
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = BASE_URL + '/post/<%= post.id %>/delete';
      document.body.appendChild(form);
      form.submit();
    }
  </script>
  <script src="<%= baseUrl %>/blog.js"></script>
</body>
</html>
