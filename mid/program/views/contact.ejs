<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('site_title_contact') %></title>
  <meta name="description" content="<%= t('contact_subtitle') %>">
  <meta property="og:title" content="<%= t('site_title_contact') %>">
  <meta property="og:description" content="<%= t('contact_subtitle') %>">
  <meta property="og:url" content="<%= baseUrl %>/contact">
  <link rel="canonical" href="<%= baseUrl %>/contact">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f2f0e9; --bg-card: rgba(255,255,255,0.8); --text: #1a1a1a; --text-secondary: #555;
      --border: rgba(0,0,0,0.1); --accent: #000; --shadow: rgba(0,0,0,0.08);
      --hover-bg: rgba(0,0,0,0.05); --tag-bg: #e8e6df;
    }
    [data-theme="dark"] {
      --bg: #1a1a1a; --bg-card: rgba(30,30,30,0.9); --text: #e0e0e0; --text-secondary: #999;
      --border: rgba(255,255,255,0.1); --accent: #fff; --shadow: rgba(0,0,0,0.3);
      --hover-bg: rgba(255,255,255,0.08); --tag-bg: #2a2a2a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0; font-family: 'Noto Serif TC', serif;
      background: var(--bg); color: var(--text);
      transition: background 0.3s, color 0.3s;
      display: flex; flex-direction: column; align-items: center; min-height: 100vh;
    }
    .container { width: 90%; max-width: 720px; padding: 40px 0; flex: 1; }

    .site-nav { background-color: #000; margin-bottom: 40px; }
    .site-nav ul { list-style: none; margin: 0; padding: 0 10px; display: flex; flex-wrap: wrap; }
    .site-nav li a { color: #fff; text-decoration: none; display: block; padding: 8px 14px; font-size: 14px; }
    .site-nav li a:hover { text-decoration: underline; }
    .dropdown { position: relative; }
    .dropdown-menu {
      position: absolute; top: 100%; left: 0; background: #000;
      flex-direction: column; min-width: 140px; z-index: 9999;
      padding: 4px 0; margin: 0; list-style: none;
      opacity: 0; visibility: hidden; pointer-events: none;
      transform: translateY(-4px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }
    .dropdown:hover .dropdown-menu,
    .dropdown.active .dropdown-menu {
      opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0);
    }
    .dropdown-menu li a { white-space: nowrap; padding: 8px 14px; display: block; }
    .dropdown-menu li a:hover { background: rgba(255,255,255,0.1); }
    .dropdown > a .arrow { display: inline-block; transition: transform 0.25s ease; font-size: 0.7rem; margin-left: 4px; }
    .dropdown:hover > a .arrow,
    .dropdown.active > a .arrow { transform: rotate(180deg); }

    h1 { font-size: 2rem; margin: 0 0 8px; }
    .subtitle { color: var(--text-secondary); margin-bottom: 32px; }

    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
    .contact-info h2 { font-size: 1.1rem; margin: 0 0 16px; }
    .contact-info p { line-height: 1.7; color: var(--text-secondary); margin: 0 0 12px; font-size: 0.95rem; }
    .contact-links { margin-top: 20px; }
    .contact-links a {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 16px; border: 1px solid var(--border); border-radius: 20px;
      text-decoration: none; color: var(--text-secondary); font-size: 0.85rem;
      background: var(--bg-card); margin: 0 8px 8px 0; transition: 0.2s;
    }
    .contact-links a:hover { background: var(--hover-bg); color: var(--text); }

    .form-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 8px; padding: 24px;
    }
    .form-card label { display: block; font-size: 0.9rem; font-weight: 700; margin: 0 0 4px; }
    .form-card input, .form-card textarea {
      width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: 6px;
      font-size: 1rem; background: var(--bg); color: var(--text);
      font-family: 'Noto Serif TC', serif; outline: none; margin-bottom: 16px;
      box-sizing: border-box; transition: 0.2s;
    }
    .form-card input:focus, .form-card textarea:focus { border-color: var(--accent); }
    .form-card textarea { min-height: 140px; resize: vertical; }
    .form-card button {
      width: 100%; padding: 12px; background: var(--accent); color: var(--bg);
      border: none; border-radius: 6px; font-size: 1rem;
      font-family: 'Noto Serif TC', serif; cursor: pointer; transition: 0.2s;
    }
    .form-card button:hover { opacity: 0.85; }
    .form-card .help-text { font-size: 0.8rem; color: var(--text-secondary); margin: -12px 0 16px; }
    .success-msg {
      padding: 16px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 6px;
      color: #155724; margin-bottom: 20px; text-align: center;
    }
    .error-msg {
      padding: 16px; background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 6px;
      color: #721c24; margin-bottom: 20px; text-align: center;
    }

    .site-footer { border-top: 4px solid #000; padding: 20px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #666; margin-top: 40px; }
    .site-footer strong { font-size: 16px; color: #000; }
    .footer-desc { font-size: 12px; color: #888; margin-left: 8px; }
    .footer-right { text-align: right; }
    .footer-links { margin-left: 12px; }
    .footer-links a { color: #888; text-decoration: none; margin-left: 8px; }
    .footer-links a:hover { color: #0066cc; text-decoration: underline; }
    .site-footer a { color: #888; text-decoration: none; }
    .site-footer a:hover { color: #0066cc; text-decoration: underline; }

    @media (max-width: 600px) {
      .container { width: 95%; padding: 20px 0; }
      .contact-grid { grid-template-columns: 1fr; }
      .site-footer { flex-direction: column; gap: 8px; text-align: center; }
      .footer-right { text-align: center; }
      .footer-desc { display: none; }
    }
  </style>
</head>
<body>
  <div class="container">
    <%- include('partials/navbar') %>
    <h1>✉️ <%= t('contact_title') %></h1>
    <p class="subtitle"><%= t('contact_subtitle') %></p>

    <% if (locals.success) { %>
    <div class="success-msg">✅ <%= t('contact_success') %></div>
    <% } %>
    <% if (locals.error) { %>
    <div class="error-msg">❌ <%= error %></div>
    <% } %>

    <div class="contact-grid">
      <div class="contact-info">
        <h2>📬 <%= t('contact_info_title') %></h2>
        <p><%= t('contact_info_desc') %></p>
        <div class="contact-links">
          <a href="<%= baseUrl %>/rss.xml" target="_blank">📡 <%= t('contact_rss') %></a>
          <a href="https://github.com" target="_blank">💻 <%= t('contact_github') %></a>
        </div>
        <p style="margin-top:24px;font-size:0.85rem;color:var(--text-secondary);">
          💡 <%= t('contact_response_time') %>
        </p>
      </div>

      <div class="form-card">
        <form action="<%= baseUrl %>/contact" method="POST">
          <label for="name"><%= t('contact_label_name') %></label>
          <input type="text" id="name" name="name" required placeholder="<%= t('contact_placeholder_name') %>">

          <label for="email"><%= t('contact_label_email') %></label>
          <input type="email" id="email" name="email" required placeholder="<%= t('contact_placeholder_email') %>">
          <p class="help-text"><%= t('contact_help_email') %></p>

          <label for="subject"><%= t('contact_label_subject') %></label>
          <input type="text" id="subject" name="subject" required placeholder="<%= t('contact_placeholder_subject') %>">

          <label for="message"><%= t('contact_label_message') %></label>
          <textarea id="message" name="message" required placeholder="<%= t('contact_placeholder_message') %>"></textarea>

          <button type="submit"><%= t('contact_btn_submit') %></button>
        </form>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    (function() {
      const t = localStorage.getItem('theme');
      const sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t || sys);
    })();
  </script>
</body>
</html>