<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('site_title_privacy') %></title>
  <meta name="robots" content="noindex">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root { --bg: #f2f0e9; --bg-card: rgba(255,255,255,0.8); --text: #1a1a1a; --text-secondary: #555; --border: rgba(0,0,0,0.1); --accent: #000; --shadow: rgba(0,0,0,0.08); --hover-bg: rgba(0,0,0,0.05); --tag-bg: #e8e6df; }
    [data-theme="dark"] { --bg: #1a1a1a; --bg-card: rgba(30,30,30,0.9); --text: #e0e0e0; --text-secondary: #999; --border: rgba(255,255,255,0.1); --accent: #fff; --shadow: rgba(0,0,0,0.3); --hover-bg: rgba(255,255,255,0.08); --tag-bg: #2a2a2a; }
    * { box-sizing: border-box; }
    body { margin:0; padding:0; font-family:'Noto Serif TC',serif; background:var(--bg); color:var(--text); transition:.3s; display:flex; flex-direction:column; align-items:center; min-height:100vh; }
    .container { width:90%; max-width:720px; padding:40px 0; flex:1; }
    h1 { font-size:1.8rem; }
    h2 { font-size:1.2rem; margin-top:28px; }
    p { line-height:1.8; color:var(--text-secondary); }
    a { color:var(--accent); }
    @media (max-width:600px) { .container { width:95%; padding:20px 0; } }
  </style>
</head>
<body>
  <div class="container">
    <h1>🔒 <%= t('privacy_title') %></h1>
    <p><%= t('privacy_updated') %></p>

    <h2><%= t('privacy_section1_title') %></h2>
    <p><%= t('privacy_section1_p1') %></p>
    <p><%= t('privacy_section1_p2') %></p>
    <p><%= t('privacy_section1_p3') %></p>

    <h2><%= t('privacy_section2_title') %></h2>
    <p><%= t('privacy_section2_p1') %></p>

    <h2><%= t('privacy_section3_title') %></h2>
    <p><%= t('privacy_section3_p1') %></p>

    <h2><%= t('privacy_section4_title') %></h2>
    <p><%= t('privacy_section4_p1') %></p>

    <h2><%= t('privacy_section5_title') %></h2>
    <p><%= t('privacy_section5_p1') %> <a href="<%= baseUrl %>/contact"><%= t('privacy_section5_link') %></a><%= t('privacy_section5_suffix') %></p>

    <p style="margin-top:32px;"><a href="<%= baseUrl %>/"><%= t('privacy_back') %></a></p>
  </div>
  <script>(function(){const t=localStorage.getItem('theme');const s=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t||s);})();</script>
</body>
</html>