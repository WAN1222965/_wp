<footer class="site-footer">
  <div class="footer-left">
    <strong><%= t('site_name') %></strong>
    <span class="footer-desc"><%= t('footer_desc') %></span>
  </div>
  <div class="footer-right">
    &copy; <%= new Date().getFullYear() %> <%= t('site_name') %>. All rights reserved.
    <span class="footer-links">
      <a href="<%= baseUrl %>/privacy"><%= t('footer_privacy') %></a>
      <a href="<%= baseUrl %>/rss.xml" target="_blank"><%= t('footer_rss') %></a>
      <a href="<%= baseUrl %>/sitemap.xml" target="_blank"><%= t('footer_sitemap') %></a>
    </span>
  </div>
</footer>

<% if (typeof gaId !== 'undefined' && gaId) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '<%= gaId %>');
</script>
<% } %>
