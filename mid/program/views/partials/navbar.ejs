<nav class="site-nav">
  <ul>
    <li><a href="<%= baseUrl %>/"><span>📝</span> 網誌</a></li>
    <li><a href="<%= baseUrl %>/about"><span>ℹ️</span> 關於</a></li>
    <li><a href="<%= baseUrl %>/notes"><span>✏️</span> 隨筆</a></li>
    <li class="dropdown">
      <a href="#" onclick="toggleDropdown(event)"><span>🎮</span> 互動專案 <span class="arrow">▾</span></a>
      <ul class="dropdown-menu">
        <li><a href="<%= baseUrl %>/snake.html"><span>🐍</span> 貪吃蛇</a></li>
        <li><a href="<%= baseUrl %>/whack.html"><span>🎯</span> 捕墨</a></li>
        <li><a href="<%= baseUrl %>/maze.html"><span>🏃</span> 墨陣</a></li>
        <li><a href="<%= baseUrl %>/leaderboard.html"><span>🏆</span> 排行</a></li>
      </ul>
    </li>
    <li><a href="<%= baseUrl %>/news.html"><span>📰</span> 新聞</a></li>
    <li><a href="<%= baseUrl %>/market.html"><span>📊</span> 行情</a></li>
    <li><a href="<%= baseUrl %>/contact"><span>✉️</span> 聯絡</a></li>
    <li><a href="<%= baseUrl %>/login.html"><span>🔑</span> 登入</a></li>
  </ul>
</nav>
<style>
.dropdown.active > a .arrow {
  transform: rotate(180deg);
}
</style>
<script>
function toggleDropdown(e) {
  e.preventDefault();
  e.stopPropagation();
  e.currentTarget.parentElement.classList.toggle('active');
}
document.addEventListener('click', function(e) {
  document.querySelectorAll('.dropdown.active').forEach(function(d) {
    if (!d.contains(e.target)) d.classList.remove('active');
  });
});
(function() {
  var user;
  try { user = JSON.parse(localStorage.getItem('user')); } catch(e) {}
  if (user) {
    var links = document.querySelectorAll('.site-nav a');
    for (var i = 0; i < links.length; i++) {
      if (links[i].textContent.includes('登入')) {
        links[i].innerHTML = '<span>👤</span> ' + (user.nickname || user.username);
        links[i].href = '<%= baseUrl %>/notes';
        break;
      }
    }
  }
})();
</script>
