<nav class="site-nav">
  <ul>
    <li><a href="<%= baseUrl %>/"><span>📝</span> <%= t('nav_blog') %></a></li>
    <li><a href="<%= baseUrl %>/about"><span>ℹ️</span> <%= t('nav_about') %></a></li>
    <li><a href="<%= baseUrl %>/notes"><span>✏️</span> <%= t('nav_notes') %></a></li>
    <li class="dropdown">
      <a href="#" id="dropdownToggle"><span>🎮</span> <%= t('nav_interactive') %> <span class="arrow">▾</span></a>
      <ul class="dropdown-menu">
        <li><a href="<%= baseUrl %>/snake.html"><span>🐍</span> <%= t('nav_snake') %></a></li>
        <li><a href="<%= baseUrl %>/whack.html"><span>🎯</span> <%= t('nav_whack') %></a></li>
        <li><a href="<%= baseUrl %>/maze.html"><span>🏃</span> <%= t('nav_maze') %></a></li>
        <li><a href="<%= baseUrl %>/leaderboard.html"><span>🏆</span> <%= t('nav_leaderboard') %></a></li>
      </ul>
    </li>
    <li><a href="<%= baseUrl %>/news.html"><span>📰</span> <%= t('nav_news') %></a></li>
    <li><a href="<%= baseUrl %>/market.html"><span>📊</span> <%= t('nav_market') %></a></li>
    <li><a href="<%= baseUrl %>/contact"><span>✉️</span> <%= t('nav_contact') %></a></li>
    <li><a href="<%= baseUrl %>/login.html"><span>🔑</span> <%= t('nav_login') %></a></li>
    <li style="margin-left:auto;display:flex;align-items:center;gap:2px;padding:0 6px;">
      <a href="<%= baseUrl %>/lang/zh-TW" style="<%= lang === 'zh-TW' ? 'color:#fff;font-weight:bold;' : 'color:#999;' %>;font-size:12px;padding:4px 4px;">繁</a>
      <span style="color:#444;font-size:10px;">|</span>
      <a href="<%= baseUrl %>/lang/en" style="<%= lang === 'en' ? 'color:#fff;font-weight:bold;' : 'color:#999;' %>;font-size:12px;padding:4px 4px;">EN</a>
      <span style="color:#444;font-size:10px;">|</span>
      <a href="<%= baseUrl %>/lang/ja" style="<%= lang === 'ja' ? 'color:#fff;font-weight:bold;' : 'color:#999;' %>;font-size:12px;padding:4px 4px;">日</a>
    </li>
  </ul>
</nav>
<style>
.dropdown.active > a .arrow {
  transform: rotate(180deg);
}
</style>
<script>
(function () {
  var dropdown = document.querySelector('.dropdown');
  if (!dropdown) return;

  var closeTimer = null;
  var HOVER_DELAY = 200;

  function openDropdown() {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    dropdown.classList.add('active');
  }

  function closeDropdown() {
    if (closeTimer) return;
    closeTimer = setTimeout(function () {
      dropdown.classList.remove('active');
      closeTimer = null;
    }, HOVER_DELAY);
  }

  function cancelClose() {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
  }

  // Hover: 滑入展開
  dropdown.addEventListener('mouseenter', openDropdown);
  dropdown.addEventListener('mouseleave', closeDropdown);

  // 選單內部懸停時取消關閉
  var menu = dropdown.querySelector('.dropdown-menu');
  if (menu) {
    menu.addEventListener('mouseenter', cancelClose);
    menu.addEventListener('mouseleave', function (e) {
      // 只在真的離開選單時才啟動關閉計時
      if (!dropdown.contains(e.relatedTarget)) closeDropdown();
    });
  }

  // Click: touch 裝置 fallback，點擊切換
  var toggle = dropdown.querySelector('a[href="#"]');
  if (toggle) {
    toggle.addEventListener('click', function (e) {
      e.preventDefault();
      if (dropdown.classList.contains('active')) {
        dropdown.classList.remove('active');
      } else {
        openDropdown();
      }
    });
  }

  // 點擊外部關閉
  document.addEventListener('click', function (e) {
    if (dropdown.classList.contains('active') && !dropdown.contains(e.target)) {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      dropdown.classList.remove('active');
    }
  });

  // IIFE auth check
  (function () {
    var loginLabel = '<%= t('nav_login') %>';
    function updateNav(user) {
      var links = document.querySelectorAll('.site-nav a');
      for (var i = 0; i < links.length; i++) {
        if (links[i].textContent.indexOf(loginLabel) !== -1) {
          if (user) {
            links[i].innerHTML = '<span>👤</span> ' + (user.nickname || user.username);
            links[i].href = '<%= baseUrl %>/notes';
          }
          break;
        }
      }
    }
    var user;
    try { user = JSON.parse(localStorage.getItem('user')); } catch (e) {}
    if (user) { updateNav(user); }
    fetch('<%= baseUrl %>/api/auth/me').then(function (r) { return r.json(); }).then(function (d) {
      if (d.authenticated) {
        localStorage.setItem('user', JSON.stringify(d.user));
        updateNav(d.user);
      }
    }).catch(function () {});
  })();

})();
</script>
